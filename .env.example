# Copy this file to ".env" and fill in your details.

# --- Free option: Google AI Studio (Gemini) ---
# 1. Go to https://aistudio.google.com/apikey
# 2. Create an API key (free, no card needed)
# 3. Paste it below
AI_API_KEY=

# Gemini's OpenAI-compatible endpoint:
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Check the model dropdown in AI Studio if this one is not available:
AI_MODEL=gemini-3.1-flash-lite


# --- Using OpenAI instead? Then set: ---
# AI_API_KEY=sk-...
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini
